# LangSmith tracing (set your key here)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=website-testing-agent

# Ollama models (defaults shown)
PLANNING_MODEL=qwen3.5:35b
EXECUTION_MODEL=qwen3.5:35b
GENERATION_MODEL=qwen2.5-coder:14b-instruct
# Context window size
NUM_CTX=8192

# Max tool-call iterations per step before giving up
MAX_STEP_ITERATIONS=20

# Set to true for CI / headless environments
BROWSER_HEADLESS=false
